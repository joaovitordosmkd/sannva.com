rules_version = '2';
// DistribuiPro · Regras do Storage (37.4). O sistema guarda as fotos dentro do próprio Firestore,
// então o Storage fica fechado: só usuário logado, arquivos de até 5 MB e só imagens/PDF.
// Como usar: Console do Firebase › Storage › Regras › apague tudo › cole este arquivo › Publicar.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}