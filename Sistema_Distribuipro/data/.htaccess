# DistribuiPro · pasta fechada. O retrato de produtos (produtos-snapshot.json) só sai por api/produtos-snapshot.php,
# para usuário logado. Não apague este arquivo.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
